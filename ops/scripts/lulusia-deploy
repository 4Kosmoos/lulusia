#!/usr/bin/env bash
# Déploiement du bot Discord et du serveur MCP distant : met le repo à jour (git pull) et reconstruit
# leurs conteneurs. Lancé par GitHub Actions avec une clé SSH qui n'autorise que cette commande (voir
# docs/exploitation.md, « Déploiement automatique »), ou à la main sur le serveur :
#   lulusia-deploy            (dernière version de main)
#   lulusia-deploy <commit>   (échoue si ce commit n'est pas dans la version récupérée)
# Une application sans .env sur le serveur (pas encore configurée) est sautée.
set -euo pipefail

REPO=/home/ubuntu/lulusia
APPS=(bot mcp)

# Avec la clé de déploiement, SSH remplace la commande demandée par ce script et la range ici.
wanted="${SSH_ORIGINAL_COMMAND:-${1:-}}"
if [ -n "$wanted" ] && ! [[ "$wanted" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Argument refusé : seul un identifiant de commit complet (40 caractères hexadécimaux) est accepté." >&2
  exit 2
fi

cd "$REPO"
echo "== Mise à jour du repo"
git pull --ff-only
if [ -n "$wanted" ] && ! git merge-base --is-ancestor "$wanted" HEAD; then
  echo "ERREUR : le commit $wanted n'est pas dans la version récupérée." >&2
  exit 1
fi
echo "Version déployée : $(git log -1 --format='%h %s')"

deployed=()
for app in "${APPS[@]}"; do
  cd "$REPO/$app"
  if [ ! -f .env ]; then
    echo "== $app : pas de .env sur ce serveur, application sautée"
    continue
  fi
  echo "== $app : reconstruction"
  sudo docker compose up -d --build
  deployed+=("$app")
done
sleep 10

# Chaque service de chaque application déployée doit tourner, sinon le déploiement est en échec (visible
# dans GitHub Actions). Le serveur MCP en a deux : le serveur lui-même et sa machine Tailscale.
failed=0
for app in "${deployed[@]}"; do
  cd "$REPO/$app"
  echo "== $app : état"
  sudo docker compose ps --format '{{.Name}} : {{.Status}}'
  echo "== $app : derniers logs"
  sudo docker compose logs --tail 15 --no-color
  expected=$(sudo docker compose config --services | sort)
  running=$(sudo docker compose ps --services --status running | sort)
  if [ "$expected" != "$running" ]; then
    echo "ERREUR : $app : service(s) arrêté(s) après le déploiement :" $(comm -23 <(echo "$expected") <(echo "$running")) >&2
    failed=1
  fi
done
[ "$failed" -eq 0 ] || exit 1
echo "== Déploiement terminé"
