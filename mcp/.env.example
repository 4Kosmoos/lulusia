# Remote MCP server (src/http.ts), in production on the VPS: copy to mcp/.env (never committed).
# The local stdio version (src/index.ts) only needs FRM_URL, set in Claude's configuration.
# The tailscale container reads its auth key from another file, .env.tailscale: see docker-compose.yml.

# FRM's web server. On the VPS, from the container: the host machine.
FRM_URL=http://host.docker.internal:8080

# Public URL of the MCP endpoint, exactly as entered in Claude (Customize > Connectors): the Funnel
# address of the lulusia-mcp Tailscale machine, on the standard HTTPS port (no port in the URL). It is
# also the audience of the access tokens: declare the same URL as a resource indicator at the
# authorization server.
MCP_PUBLIC_URL=https://lulusia-mcp.<tailnet>.ts.net/mcp

# The authorization server (WorkOS AuthKit domain), which signs users in and issues the access tokens.
OAUTH_ISSUER=https://<your-subdomain>.authkit.app

# Users allowed to use the server: their IDs at the authorization server (token subject), comma-separated.
ALLOWED_USERS=user_...,user_...

# Port inside the container: published on 127.0.0.1 of the VPS, and the target of the Funnel
# (tailscale/serve.json, to change too if this port changes).
PORT=3100
