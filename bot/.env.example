# Copier ce fichier en .env et le remplir. Le .env n'est JAMAIS commité.

# Jeton du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Identifiants des salons (mode développeur Discord : clic droit sur le salon > Copier l'identifiant)
STATUS_CHANNEL_ID=
# Salon du pont avec le chat du jeu (laisser vide pour désactiver le pont)
CHAT_CHANNEL_ID=
# Salon des alertes de surveillance : serveur qui ne répond plus, RAM ou disque presque pleins.
# En production seulement (en local, le bot surveillerait le PC) : laisser vide pour désactiver.
ALERT_CHANNEL_ID=

# Signal de vie (Healthchecks.io > le check du bot > Ping URL). Secret. En production seulement.
# Si le signal cesse (VPS ou bot en panne), Healthchecks.io prévient sur Discord.
HEALTHCHECK_URL=

# Adresse de FRM
#  - en dev sur le PC, via Tailscale : http://lulusia.<nom-du-tailnet>.ts.net:8080
#  - en prod dans Docker sur le VPS : http://host.docker.internal:8080
FRM_URL=

# Jeton FRM (Gestionnaire de serveur > Paramètres du serveur > FRM > API Authentication Token).
# Nécessaire pour les actions d'écriture : envoyer dans le jeu les messages du salon du pont, /ping.
FRM_TOKEN=

# Fréquences (en secondes)
STATUS_INTERVAL_SECONDS=60
CHAT_POLL_SECONDS=3
