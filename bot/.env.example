# Copy this file to .env and fill it in. The .env is NEVER committed.

# Bot token (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Channel IDs (Discord developer mode: right-click the channel > Copy Channel ID)
STATUS_CHANNEL_ID=
# Channel bridged with the game chat (leave empty to disable the bridge)
CHAT_CHANNEL_ID=
# Channel for monitoring alerts (server not responding, RAM or disk almost full) and custom alerts.
# Production only (locally, the bot would monitor the PC): leave empty to disable.
ALERT_CHANNEL_ID=

# Heartbeat (Healthchecks.io > the bot's check > Ping URL). Secret. Production only.
# If the heartbeat stops (VPS or bot down), Healthchecks.io warns on Discord.
HEALTHCHECK_URL=

# FRM address
#  - in dev on the PC, through Tailscale: http://lulusia.<tailnet-name>.ts.net:8080
#  - in prod in Docker on the VPS: http://host.docker.internal:8080
FRM_URL=

# FRM token (Server Manager > Server Settings > FRM > API Authentication Token).
# Needed for write actions: sending the bridge channel's messages to the game, /ping,
# turning switches on or off, pausing or resuming machines.
FRM_TOKEN=

# Intervals (in seconds)
STATUS_INTERVAL_SECONDS=60
CHAT_POLL_SECONDS=3
